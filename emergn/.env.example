# EMERGN. Environment Variables
# Copy this file to .env.local and fill in values

# Site URL (used for OG images and metadata)
NEXT_PUBLIC_SITE_URL=https://emergn.org

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Optional server-side Solana RPC fallback (defaults to NEXT_PUBLIC_SOLANA_RPC_URL)
SOLANA_RPC_URL=

# Anthropic (for agent AI via Vercel AI SDK)
ANTHROPIC_API_KEY=

# X personality import
TWITTERAPI_IO_KEY=

# Portfolio analysis
HELIUS_API_KEY=

# Credits / payments — V1 ships in operator-paid mode (we cover AI costs).
# User-paid purchases are disabled in code even if these values are set.
# Keep these blank unless you are preparing a future/canary payment rail.
EMRG_TOKEN_MINT=
EMERGN_TREASURY_WALLET=
EMRG_TOKEN_DECIMALS=6
NEXT_PUBLIC_EMRG_TOKEN_MINT=
NEXT_PUBLIC_EMERGN_TREASURY_WALLET=

# Agent Token Launch (EMERGN. minting pipeline)
# Branded socials applied server-side to every launched token's metadata.
# These always win — user X handles are never forwarded on-chain.
NEXT_PUBLIC_EMERGN_X_HANDLE=https://x.com/emergndotorg
PUMPPORTAL_API_KEY=
PINATA_JWT=
TOKEN_LAUNCH_ALLOWLIST=

# Optional token market data
BIRDEYE_API_KEY=

# Optional: hours between agent personality refinements (default 24)
REFINEMENT_COOLDOWN_HOURS=24

# Admin console — bootstrap allowlists. Any of the four matchers grants admin.
# Use whichever maps to how you sign in (email/UUID/X handle/wallet).
# Once a profiles row has role='admin', these env entries are no longer needed.
ADMIN_USER_EMAILS=team@emergn.org
ADMIN_USER_IDS=
ADMIN_X_HANDLES=
ADMIN_WALLETS=

# Operator-paid trial defaults (legacy three-pool — kept for back-compat).
DEFAULT_FREE_CONSULTS=5
DEFAULT_TRAINING_CREDITS=10
DEFAULT_PREMIUM_CREDITS=3

# Unified credit economy (V1 single-pool model)
DEFAULT_ACTION_CREDITS=5
MAX_ACTION_CREDITS=50
MAX_EARNED_CREDITS_PER_DAY=3

# Per-user daily caps (admin can override per-user via profiles.usage_quota_overrides)
MAX_X_CALLS_PER_DAY=5
MAX_ANTHROPIC_TOKENS_PER_DAY=50000
MAX_TRAININGS_PER_DAY=10
MAX_CONSULTS_PER_DAY=20

# Cost dashboard estimate (Claude Sonnet 4 weighted blend)
ANTHROPIC_USD_PER_1K_TOKENS=0.009

# Monthly Anthropic budget (USD). When set, the admin cost dashboard shows a
# progress bar and warns at 70% / 90% projected spend. Operator-only.
MONTHLY_BUDGET_USD=50

# Soft global circuit breaker for TwitterAPI.io (calls per process per day)
TWITTERAPI_DAILY_BUDGET=2000

# Higgsfield AI passport image rendering. Mint a token by running
# `higgsfield auth login` in a terminal, then copy `access_token` from
# ~/.config/higgsfield/credentials.json into HIGGSFIELD_API_KEY.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://fnf.higgsfield.ai
HIGGSFIELD_MODEL_ID=gpt_image_2
# Soft global circuit breaker for Higgsfield jobs (calls per process per day)
HIGGSFIELD_DAILY_BUDGET=100
